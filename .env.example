# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Models (main: research and answers; fast: triage and citation checks)
CITEWISE_MODEL=claude-sonnet-5-5
CITEWISE_FAST_MODEL=claude-haiku-5-5

# NCBI asks for a contact email. An API key raises the limit from 3 to 10 requests a second.
NCBI_EMAIL=
NCBI_API_KEY=

# Optional cost reporting: USD per million [input, output] tokens, from the current price list.
# CITEWISE_PRICES={"claude-sonnet-5-5": [0, 0], "claude-haiku-5-5": [0, 0]}

# Demo protection
CITEWISE_RATE_LIMIT_PER_MINUTE=5
CITEWISE_DAILY_TOKEN_BUDGET=2000000

# Optional Langfuse tracing (pip install ".[tracing]")
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
